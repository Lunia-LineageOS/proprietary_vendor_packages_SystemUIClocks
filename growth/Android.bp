android_app {
    name: "SystemUIClocks-Growth",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    use_resource_processor: true,

    kotlincflags: ["-Xjvm-default=all"],

    libs: [
        "SystemUIPluginLib",
    ],
    static_libs: [
        "SystemUIClocks-CoreLib",
    ],

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    platform_apis: true,
    min_sdk_version: "current",

    optimize: {
        enabled: true,
        shrink_resources: true,
        optimized_shrink_resources: true,
        proguard_flags_files: ["proguard_growth.flags"],
        included_proguard_flags_files: [":sysui_proguard_common_and_kotlin"],
    },
}
